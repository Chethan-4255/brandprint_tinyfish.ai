xclamationRate":3,"questionRate":6,"contractionRate":16,"emojiCount":2,"headingCase":"Sentence case","formalityMarkers":0},"examples":[{"text":"The most ambitious companies run on Notion.","source":"https://www.notion.com/"},{"text":"G2’s #1 knowledge base for 3 consecutive years","source":"https://www.notion.com/"},{"text":"If you’re reading this, you’re probably like me—spending most of your days in your office, in front of a computer.","source":"https://www.notion.so/about"},{"text":"You probably have fifteen tabs open: one for email, one for Slack, one for Google Docs, and on, and on…But have you ever thought about where these “work tools” came from?","source":"https://www.notion.so/about"},{"text":"It looks like your ad blocker is preventing the video from playing.","source":"https://www.notion.so/careers"}],"summary":"11.5 words per sentence on average, 19% of sentences address the reader as “you”, 28% speak as “we”, Flesch reading ease 63 (easy), contractions in 16% of sentences, headings in sentence case."},"messaging":{"taglines":[{"text":"Where teams and agents Think together.","source":"https://www.notion.com/"}],"valueProps":[{"text":"AI where your team works.","source":"https://www.notion.com/"},{"text":"Bring everything into one system of record.","source":"https://www.notion.com/"},{"text":"Get answers, instantly—with citations.","source":"https://www.notion.com/"},{"text":"Keep work moving 24/7 with agents.","source":"https://www.notion.com/"},{"text":"Trusted by teams that ship.","source":"https://www.notion.com/"},{"text":"Capture","source":"https://www.notion.com/"},{"text":"Find","source":"https://www.notion.com/"},{"text":"Automate","source":"https://www.notion.com/"}],"keywords":[{"phrase":"tools","count":5},{"phrase":"customers","count":5},{"phrase":"google docs","count":4},{"phrase":"industrial revolution","count":4},{"phrase":"file cabinets","count":4},{"phrase":"far beyond","count":4},{"phrase":"alan kay","count":4},{"phrase":"san francisco